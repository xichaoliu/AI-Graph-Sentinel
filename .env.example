# Docker Compose 本地配置（可选）：
#   cp .env.example .env
# 这里只控制宿主机端口与时区；复制成 .env 后由 Docker Compose 自动读取。

# 大屏访问端口
FRONTEND_PORT=8080
# 后端 API 端口（也可直接访问 /docs 调试）
BACKEND_PORT=8000
TZ=Asia/Shanghai

# 大模型配置（LLM_NAME / LLM_API_KEY / LLM_API_BASE）请修改 backend/app/.env，
# docker compose 会在运行时通过 env_file 注入，不会打进镜像。
