# Docker Compose 本地配置（可选）：
#   cp .env.example .env
# 这里只控制宿主机端口与时区；复制成 .env 后由 Docker Compose 自动读取。

# 前端 HTTP / HTTPS 端口（生产环境保持 80 / 443）
# 注意：若修改 HTTPS_PORT，nginx.conf 中 301 跳转目标也要同步加端口
HTTP_PORT=80
HTTPS_PORT=443

# 后端 API 端口（也可直接访问 /docs 调试）
BACKEND_PORT=8000
TZ=Asia/Shanghai

# 域名：viasaber.ink / www.viasaber.ink
# 证书文件位于 bigscreen/ssl/，compose 会以只读卷挂载到 nginx 容器

# 大模型配置（LLM_NAME / LLM_API_KEY / LLM_API_BASE）请修改 backend/app/.env，
# docker compose 会在运行时通过 env_file 注入，不会打进镜像。
